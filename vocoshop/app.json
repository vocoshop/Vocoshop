{
  "expo": {
    "name": "vocoshop",
    "slug": "vocoshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "vocoshop",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0617"
    },

"ios": {
"supportsTablet": true,
"bundleIdentifier": "com.doncarly.vocoshop",
"infoPlist": {
"ITSAppUsesNonExemptEncryption": false,
"NSMicrophoneUsageDescription": "Vocoshop utilise le micro pour enregistrer les ventes vocales."
}
},

"android": {
"package": "com.don_carly.vocoshop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8A4DFF"
      },
"edgeToEdgeEnabled": true,
"predictiveBackGestureEnabled": false,
"permissions": [
"android.permission.CAMERA",
"android.permission.RECORD_AUDIO"
]
},

"plugins": [
  "expo-image-picker",
  "expo-media-library",
  "expo-camera",
  "expo-splash-screen",
  [
    "expo-notifications",
    {
      "sounds": []
    }
  ]
],

"extra": {
  "EXPO_PUBLIC_API_URL": "https://vocoshop.onrender.com",
  "eas": {
    "projectId": "919b0a70-eae9-414a-8493-c0197daa9337"
  }
}
}
}
