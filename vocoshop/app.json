{
  "expo": {
    "name": "vocoshop",
    "slug": "vocoshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "vocoshop",

"ios": {
"supportsTablet": true,
"bundleIdentifier": "com.doncarly.vocoshop",
"infoPlist": {
"ITSAppUsesNonExemptEncryption": false,
"NSMicrophoneUsageDescription": "Vocoshop utilise le micro pour enregistrer les ventes vocales."
}
},

"android": {
"package": "com.don_carly.vocoshop",
"adaptiveIcon": {
"foregroundImage": "./assets/adaptive-icon.png",
"backgroundColor": "#070014"
},
"edgeToEdgeEnabled": true,
"predictiveBackGestureEnabled": false,
"permissions": [
"android.permission.CAMERA",
"android.permission.RECORD_AUDIO"
]
},

"plugins": [
  "expo-barcode-scanner",
  "expo-image-picker",
  "expo-media-library",
  [
    "expo-notifications",
    {
      "sounds": []
    }
  ]
],

"extra": {
  "EXPO_PUBLIC_API_URL": "https://unglozed-supermetropolitan-tamar.ngrok-free.dev",
  "eas": {
    "projectId": "919b0a70-eae9-414a-8493-c0197daa9337"
  }
}
}
}
