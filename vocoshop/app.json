{
  "expo": {
    "name": "vocoshop",
    "slug": "vocoshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "vocoshop",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#05060F"
    },

"ios": {
"supportsTablet": true,
"bundleIdentifier": "com.doncarly.vocoshop",
"infoPlist": {
"ITSAppUsesNonExemptEncryption": false,
"NSMicrophoneUsageDescription": "Vocoshop utilise le micro pour enregistrer les ventes vocales."
}
},

"android": {
"package": "com.don_carly.vocoshop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#501482"
      },
      "edgeToEdgeEnabled": false,
"predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "vocoshop" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
},

"plugins": [
  "expo-image-picker",
  "expo-media-library",
  "expo-camera",
  "expo-splash-screen",
  [
    "expo-notifications",
    {
      "sounds": []
    }
  ]
],

"extra": {
  "EXPO_PUBLIC_API_URL": "https://vocoshop.onrender.com",
  "eas": {
    "projectId": "919b0a70-eae9-414a-8493-c0197daa9337"
  }
}
}
}
