# =============================================================================
# 🛡️ VOCOSHOP BACKEND — PRODUCTION ENVIRONMENT TEMPLATE
# Copier ce fichier vers .env et remplacer TOUTES les valeurs
# =============================================================================

# ─── MongoDB ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://user:password@host:port/db

# ─── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
PUBLIC_BASE_URL=https://api.vocoshop.com
EXPO_DEEP_LINK_BASE=exp://your-domain/--/

# ─── Africa's Talking (SMS) ──────────────────────────────────────────────
AT_API_KEY=your_atsk_key_here
AT_USERNAME=your_production_username
AT_SENDER_ID=Vocoshop

# ─── Flutterwave (Paiements) ─────────────────────────────────────────────
# 🔴 OBLIGATOIRE — sans ces clés, les paiements tournent en SIMULATION
FLW_SECRET_KEY=your_flw_secret_key
FLW_PUBLIC_KEY=your_flw_public_key

# ─── Contact ─────────────────────────────────────────────────────────────
VOCOSHOP_CONTACT_PHONE=+242000000000

# ─── Auth secrets (🔴 CHANGEZ CES VALEURS !) ────────────────────────────
# Utilisez: openssl rand -hex 64 (Linux/Mac) ou node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre-secret-aleatoire-de-64-caracteres-minimum
AGENT_JWT_SECRET=votre-secret-aleatoire-de-64-caracteres-minimum

# ─── Super Admin fallback (utilisé si pas de config en BDD) ──────────────
ADMIN_EMAIL=admin@vocoshop.com
ADMIN_PASSWORD=ChangeMe2026!
ADMIN_NAME=Admin
ADMIN_SURNAME=

# ─── OTP & Reauth ────────────────────────────────────────────────────────
OTP_EXP_MINUTES=10
REAUTH_DAYS=14
ACTIVITY_THROTTLE_MIN=10

# ─── OpenAI (OCR, Voice IA, Chat IA) ─────────────────────────────────────
OPENAI_API_KEY=sk-proj-votre-cle-ici

# ─── Mistral AI (OCR alternatif, optionnel) ──────────────────────────────
# MISTRAL_API_KEY=your_mistral_key

# ─── Blockchain (ancrage de documents, optionnel) ────────────────────────
# Décommentez et configurez si vous utilisez l'ancrage blockchain
# BLOCKCHAIN_RPC=https://polygon-rpc.com
# BLOCKCHAIN_PRIVATE_KEY=0x....
# BLOCKCHAIN_CHAIN_ID=137

# ─── Partner API (optionnel) ─────────────────────────────────────────────
# PARTNER_API_KEYS=key1,key2,key3
